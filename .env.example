# ============================================================================
#  Churn App — environment configuration
#  Copy to `.env` (which is git-ignored) and fill in the values.
# ============================================================================

# --- Encryption at rest (REQUIRED to add/view PRIVATE data) -----------------
# Fernet key used to encrypt sensitive PRIVATE fields (last4, credit_limit,
# point balances, targeted-offer figures) at rest in the SQLite DB.
#
#   Generate one with:   python -m backend.crypto
#
# WARNING: losing this key makes encrypted data UNRECOVERABLE. Back it up
# securely OUTSIDE the repo. Do not commit it.
FERNET_KEY=

# --- Household profile labels ----------------------------------------------
# Comma-separated user labels for the two-person household UI.
CHURN_USERS=User A,User B

# --- LLM ingestion engine (PUBLIC data only) --------------------------------
# Anthropic API key. Only used by the ingestion subsystem on PUBLIC page text
# + product names. Never sees PRIVATE fields. If unset, the catalog/eligibility
# /scoring UI still works; only the Run-menu discovery/refresh actions are
# disabled.
ANTHROPIC_API_KEY=

# Cost-efficient model for discovery + extraction. Override if desired.
ANTHROPIC_MODEL=claude-haiku-4-5

# Search-capable model and caps for public web-search fallback. This is only
# used after static HTTP extraction/compact LLM extraction fail or leave gaps.
ANTHROPIC_SEARCH_MODEL=claude-sonnet-4-6
WEB_SEARCH_ENABLED=false
WEB_SEARCH_MAX_CARDS=8
WEB_SEARCH_BATCH_SIZE=8
WEB_SEARCH_MAX_USES_PER_BATCH=8
WEB_SEARCH_DISCOVERY_MAX_USES=8
ANTHROPIC_WEB_TIMEOUT_SECONDS=180
ANTHROPIC_DISCOVERY_RESEARCH_MAX_TOKENS=5000
ANTHROPIC_DISCOVERY_MAX_TOKENS=5000

# --- Storage ----------------------------------------------------------------
DATABASE_URL=sqlite:///data/churn.db

# --- Ingestion tuning -------------------------------------------------------
# Offer changes beyond this fractional delta require human approval (§4.4).
OFFER_DELTA_THRESHOLD=0.15
# If true, small high-confidence updates auto-commit instead of queueing.
AUTO_COMMIT_SMALL_CHANGES=false

# --- Later phase ------------------------------------------------------------
# Real-time award search (verify API availability/terms before use).
SEATS_AERO_API_KEY=
